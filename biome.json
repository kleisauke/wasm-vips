{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*",
      "!**/*.svg",
      "!build/preamble_vips.d.ts",
      "!lib/vips.d.ts",
      "!src/closure-externs/wasm-vips.js",
      "!src/modules-pre.js",
      "!src/vips-library.js",
      "!src/workaround-cors-pre.js"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "formatter": {
    "enabled": false,
    "useEditorconfig": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  }
}
